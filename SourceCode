<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Zip Game Runner</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script type="module">
        import * as esbuild from "https://unpkg.com/esbuild-wasm@0.23.0/esm/browser.js";
        window.__esbuild = esbuild;
        // worker:false runs esbuild on the main thread instead of spinning up a
        // Web Worker via a blob: URL. Some sandboxed/embedded environments block
        // blob-based workers via Content-Security-Policy, which causes esbuild's
        // worker script to fail to load (net::ERR_FAILED) and leaves
        // __esbuildInitPromise permanently unresolved. Main-thread mode avoids that,
        // at the cost of blocking the UI thread briefly during a build.
        window.__esbuildInitPromise = esbuild.initialize({
            wasmURL: "https://unpkg.com/esbuild-wasm@0.23.0/esbuild.wasm",
            worker: false
        }).catch(err => {
            console.error('esbuild initialize failed:', err);
            window.__esbuildInitError = err;
            throw err;
        });
    </script>
    <style>
        :root {
            --bg: #0d1117;
            --panel: #151b23;
            --panel-border: #2a323c;
            --accent: #5ee6a8;
            --accent-dim: #2f8a5e;
            --text: #e6edf3;
            --text-dim: #8b98a5;
            --danger: #ff6b6b;
            --mono: "SF Mono", "JetBrains Mono", "Cascadia Code", ui-monospace, Consolas, monospace;
            --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            background: var(--bg);
            color: var(--text);
            font-family: var(--sans);
        }

        body {
            display: flex;
            flex-direction: column;
        }

        /* Top bar */
        .topbar {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 16px;
            background: var(--panel);
            border-bottom: 1px solid var(--panel-border);
            flex-shrink: 0;
            flex-wrap: wrap;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 8px;
            font-family: var(--mono);
            font-weight: 700;
            letter-spacing: 0.02em;
            color: var(--accent);
            font-size: 14px;
            white-space: nowrap;
        }

            .brand .dot {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--accent);
                box-shadow: 0 0 8px var(--accent);
            }

        .file-info {
            font-family: var(--mono);
            font-size: 12px;
            color: var(--text-dim);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex: 1;
            min-width: 80px;
        }

            .file-info b {
                color: var(--text);
                font-weight: 600;
            }

        .btn {
            appearance: none;
            border: 1px solid var(--panel-border);
            background: #1c232c;
            color: var(--text);
            font-family: var(--sans);
            font-size: 13px;
            font-weight: 500;
            padding: 7px 14px;
            border-radius: 6px;
            cursor: pointer;
            white-space: nowrap;
            transition: border-color .15s ease, background .15s ease;
        }

            .btn:hover {
                border-color: var(--accent-dim);
                background: #222b35;
            }

            .btn:active {
                transform: translateY(1px);
            }

        .btn-primary {
            background: var(--accent);
            color: #06301d;
            border-color: var(--accent);
            font-weight: 700;
        }

            .btn-primary:hover {
                background: #7bf0bd;
                border-color: #7bf0bd;
            }

        .btn:disabled {
            opacity: .4;
            cursor: not-allowed;
        }

        select.entry-picker {
            font-family: var(--mono);
            font-size: 12px;
            background: #1c232c;
            color: var(--text);
            border: 1px solid var(--panel-border);
            border-radius: 6px;
            padding: 6px 8px;
            max-width: 220px;
        }

        input[type=file] {
            display: none;
        }

        /* Main stage */
        .stage {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 0;
            background: #000;
            overflow: hidden;
        }

        /* Wraps the game iframe. The iframe itself is always sized to the TRUE
        chosen resolution in real pixels (so the game's internal viewport,
        canvas sizing, window.innerWidth/innerHeight etc. all see the actual
        resolution) -- this wrapper is what gets visually scaled up/down via
        a CSS transform to fit the available space, so "how big it looks on
        screen" is completely decoupled from "what resolution the game thinks
        it's rendering at". Fullscreen targets this wrapper (not the iframe),
        since the transform-scale approach needs to keep working the same way
        whether we're in a small stage panel or filling the whole screen. */
        .game-frame-wrapper {
            position: relative;
            transform-origin: center center;
            flex-shrink: 0;
        }

            .game-frame-wrapper:fullscreen {
                display: flex;
                align-items: center;
                justify-content: center;
                background: #000;
                width: 100vw;
                height: 100vh;
            }

            .game-frame-wrapper:-webkit-full-screen {
                display: flex;
                align-items: center;
                justify-content: center;
                background: #000;
                width: 100vw;
                height: 100vh;
            }

        /* Game area: everything to the right of the sidebar */
        .game-area {
            flex: 1;
            position: relative;
            display: flex;
            min-height: 0;
            min-width: 0;
        }

        /* Sidebar: game library */
        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background: var(--panel);
            border-right: 1px solid var(--panel-border);
            display: flex;
            flex-direction: column;
            min-height: 0;
        }

        .sidebar-header {
            padding: 12px 12px 8px;
            font-family: var(--mono);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .04em;
            color: var(--text-dim);
            text-transform: uppercase;
            flex-shrink: 0;
        }

        .sidebar-list {
            flex: 1;
            overflow-y: auto;
            padding: 0 8px 8px;
        }

        .sidebar-empty {
            padding: 12px 8px;
            font-size: 12px;
            color: #5b6672;
            line-height: 1.5;
        }

        .game-item {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 8px;
            border-radius: 7px;
            cursor: pointer;
            margin-bottom: 2px;
            border: 1px solid transparent;
        }

            .game-item:hover {
                background: #1c232c;
            }

            .game-item.active {
                background: #16301f;
                border-color: var(--accent-dim);
            }

        .game-item-icon {
            width: 28px;
            height: 28px;
            flex-shrink: 0;
            border-radius: 6px;
            background: #1c232c;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-dim);
        }

        .game-item-info {
            flex: 1;
            min-width: 0;
        }

        .game-item-name {
            font-size: 12.5px;
            font-weight: 600;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .game-item-name[contenteditable="true"] {
                outline: 1px solid var(--accent);
                border-radius: 3px;
                padding: 0 3px;
                background: #0d1117;
                white-space: normal;
                overflow: visible;
            }

        .game-item-meta {
            font-size: 10px;
            color: #5b6672;
            font-family: var(--mono);
        }

        .game-item-actions {
            display: flex;
            gap: 2px;
            opacity: 0;
            flex-shrink: 0;
        }

        .game-item:hover .game-item-actions {
            opacity: 1;
        }

        .game-item-actions button {
            width: 22px;
            height: 22px;
            border: none;
            background: transparent;
            color: var(--text-dim);
            border-radius: 5px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .game-item-actions button:hover {
                background: #2a323c;
                color: var(--text);
            }

            .game-item-actions button.danger:hover {
                background: #4a1f1f;
                color: var(--danger);
            }

        /* Drop zone / landing */
        .dropzone {
            flex: 1;
            align-self: stretch;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

            .dropzone.dragover .dz-card {
                border-color: var(--accent);
                background: #10241a;
            }

        .dz-card {
            width: min(560px, 100%);
            border: 2px dashed var(--panel-border);
            border-radius: 14px;
            padding: 48px 32px;
            text-align: center;
            transition: border-color .15s ease, background .15s ease;
        }

        .dz-icon {
            width: 56px;
            height: 56px;
            margin: 0 auto 18px;
            color: var(--accent-dim);
        }

        .dz-card h1 {
            font-size: 19px;
            margin: 0 0 8px;
            font-weight: 700;
        }

        .dz-card p {
            color: var(--text-dim);
            font-size: 13.5px;
            line-height: 1.6;
            margin: 0 0 22px;
        }

        .dz-card code {
            font-family: var(--mono);
            background: #1c232c;
            padding: 1px 5px;
            border-radius: 4px;
            font-size: 12px;
        }

        .dz-hint {
            margin-top: 18px;
            font-size: 11.5px;
            color: #5b6672;
        }

        /* Base .game-frame sizing is defined by ".stage iframe.game-frame" further
        down (kept together with the letterbox/resolution logic notes). */

        .status-bar {
            padding: 8px 16px;
            background: var(--panel);
            border-top: 1px solid var(--panel-border);
            font-family: var(--mono);
            font-size: 11.5px;
            color: var(--text-dim);
            display: flex;
            justify-content: space-between;
            gap: 12px;
            flex-shrink: 0;
        }

            .status-bar.error {
                color: var(--danger);
            }

            .status-bar .right {
                color: #5b6672;
            }

        .spinner {
            width: 14px;
            height: 14px;
            border: 2px solid var(--panel-border);
            border-top-color: var(--accent);
            border-radius: 50%;
            animation: spin .7s linear infinite;
            display: inline-block;
            vertical-align: middle;
            margin-right: 6px;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        .error-panel {
            flex: 1;
            align-self: stretch;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
        }

        .error-card {
            max-width: 520px;
            text-align: center;
        }

            .error-card h2 {
                color: var(--danger);
                font-size: 17px;
                margin: 0 0 10px;
            }

            .error-card p {
                color: var(--text-dim);
                font-size: 13.5px;
                line-height: 1.6;
            }

        /* Debug console drawer */
        .debug-console {
            display: none;
            flex-direction: column;
            position: fixed;
            right: 0;
            bottom: 0;
            top: 0;
            width: min(480px, 100%);
            background: #0a0e13;
            border-left: 1px solid var(--panel-border);
            box-shadow: -8px 0 24px rgba(0,0,0,.4);
            z-index: 1000;
        }

            .debug-console.open {
                display: flex;
            }

        .debug-console-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 14px;
            background: var(--panel);
            border-bottom: 1px solid var(--panel-border);
            font-family: var(--mono);
            font-weight: 700;
            font-size: 13px;
            flex-shrink: 0;
        }

        .debug-console-body {
            flex: 1;
            overflow-y: auto;
            padding: 8px;
            font-family: var(--mono);
            font-size: 11.5px;
            line-height: 1.5;
        }

        .console-entry {
            padding: 6px 8px;
            border-bottom: 1px solid #1a2028;
            white-space: pre-wrap;
            word-break: break-all;
        }

            .console-entry .meta {
                color: #5b6672;
                font-size: 10px;
                margin-bottom: 2px;
                display: flex;
                gap: 6px;
            }

            .console-entry.level-error {
                color: var(--danger);
            }

            .console-entry.level-warn {
                color: #e6c15e;
            }

            .console-entry.level-info {
                color: var(--text-dim);
            }

            .console-entry.level-log {
                color: var(--text);
            }

            .console-entry .tag {
                font-weight: 700;
                padding: 0 5px;
                border-radius: 3px;
                font-size: 9.5px;
                letter-spacing: .03em;
            }

            .console-entry.source-parent .tag {
                background: #2a3f52;
                color: #7ec8ff;
            }

            .console-entry.source-iframe .tag {
                background: #3a2f52;
                color: #c39bff;
            }

            .console-entry.source-resource .tag {
                background: #4a2a2a;
                color: #ff9b9b;
            }

        @media (max-width: 720px) {
            .sidebar {
                width: 160px;
            }

            .game-item-meta {
                display: none;
            }

            .dock {
                bottom: 8px;
            }
        }

        /* Game iframe sizing: .stage itself is the letterbox container (centers
        content, black background), so the iframe just needs flex:none so its
        width/height (set by applyResolution()) aren't overridden by flex stretch. */
        .stage iframe.game-frame {
            border: none;
            background: #000;
            display: block;
        }

        .fps-overlay {
            position: absolute;
            top: 8px;
            left: 8px;
            font-family: var(--mono);
            font-size: 11px;
            background: rgba(0,0,0,.55);
            color: var(--accent);
            padding: 3px 7px;
            border-radius: 5px;
            pointer-events: none;
            z-index: 5;
        }

        /* Bottom dock */
        .dock {
            position: fixed;
            left: 50%;
            bottom: 16px;
            transform: translateX(-50%);
            display: flex;
            gap: 4px;
            background: rgba(21, 27, 35, .92);
            backdrop-filter: blur(8px);
            border: 1px solid var(--panel-border);
            border-radius: 14px;
            padding: 6px;
            box-shadow: 0 8px 24px rgba(0,0,0,.35);
            z-index: 900;
        }

        .dock-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            color: var(--text-dim);
            border-radius: 9px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background .15s ease, color .15s ease;
        }

            .dock-btn svg {
                width: 20px;
                height: 20px;
            }

            .dock-btn:hover {
                background: #222b35;
                color: var(--text);
            }

            .dock-btn.active {
                background: var(--accent);
                color: #06301d;
            }

        /* Dock popover panels */
        .dock-panel {
            display: none;
            position: fixed;
            left: 50%;
            bottom: 68px;
            transform: translateX(-50%);
            width: min(340px, calc(100vw - 32px));
            background: var(--panel);
            border: 1px solid var(--panel-border);
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,.4);
            z-index: 901;
            padding: 14px;
        }

            .dock-panel.open {
                display: block;
            }

            .dock-panel h3 {
                margin: 0 0 12px;
                font-size: 13px;
                font-weight: 700;
                font-family: var(--mono);
                color: var(--accent);
            }

        .panel-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 0;
            font-size: 13px;
            gap: 12px;
        }

            .panel-row + .panel-row {
                border-top: 1px solid #1e252d;
            }

            .panel-row label {
                flex: 1;
                cursor: pointer;
            }

        .panel-hint {
            font-size: 11px;
            color: #5b6672;
            margin-top: 2px;
            line-height: 1.4;
        }

        .panel-select {
            background: #1c232c;
            color: var(--text);
            border: 1px solid var(--panel-border);
            border-radius: 6px;
            padding: 5px 8px;
            font-family: var(--mono);
            font-size: 12px;
        }

        .panel-note {
            font-size: 11px;
            color: var(--text-dim);
            background: #1c232c;
            border-radius: 7px;
            padding: 8px 10px;
            margin-top: 10px;
            line-height: 1.5;
        }

        .custom-res-row {
            display: flex;
            align-items: center;
            gap: 6px;
            margin-top: 8px;
        }

            .custom-res-row input {
                width: 64px;
                background: #1c232c;
                color: var(--text);
                border: 1px solid var(--panel-border);
                border-radius: 6px;
                padding: 5px 6px;
                font-family: var(--mono);
                font-size: 12px;
            }

        /* Toggle switch */
        .switch {
            position: relative;
            display: inline-block;
            width: 36px;
            height: 20px;
            flex-shrink: 0;
            cursor: pointer;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
                position: absolute;
            }

            .switch .slider {
                position: absolute;
                inset: 0;
                background: #2a323c;
                border-radius: 20px;
                cursor: pointer;
                transition: background .15s ease;
            }

                .switch .slider::before {
                    content: '';
                    position: absolute;
                    width: 16px;
                    height: 16px;
                    left: 2px;
                    top: 2px;
                    background: #e6edf3;
                    border-radius: 50%;
                    transition: transform .15s ease;
                }

            .switch input:checked + .slider {
                background: var(--accent-dim);
            }

                .switch input:checked + .slider::before {
                    transform: translateX(16px);
                    background: #06301d;
                }
    </style>
</head>
<body>

    <div class="topbar">
        <div class="brand"><span class="dot"></span>ZIP RUNNER</div>
        <div class="file-info" id="fileInfo">No zip loaded</div>
        <select class="entry-picker" id="entryPicker" style="display:none;"></select>
        <button class="btn" id="reloadBtn" style="display:none;">Reload</button>
        <button class="btn" id="loadAnotherBtn" style="display:none;">Load another .zip</button>
        <button class="btn" id="fullscreenBtn" style="display:none;">⛶ Fullscreen</button>
        <button class="btn" id="consoleBtn">Console <span id="consoleBadge" style="display:none;background:var(--danger);color:#fff;border-radius:9px;padding:1px 6px;font-size:10px;margin-left:4px;">0</span></button>
        <button class="btn btn-primary" id="chooseBtn">Choose .zip</button>
        <input type="file" id="fileInput" accept=".zip,application/zip,application/x-zip-compressed">
    </div>

    <div class="game-area">
        <div class="sidebar">
            <div class="sidebar-header">Your Games</div>
            <div class="sidebar-list" id="sidebarList">
                <div class="sidebar-empty" id="sidebarEmpty">No games yet. Load a .zip to add it to your library — it'll be saved here automatically.</div>
            </div>
        </div>

        <div class="stage" id="stage">
            <div class="dropzone" id="dropzone">
                <div class="dz-card">
                    <svg class="dz-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M20 8v11a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1h9l6 6z" stroke-linejoin="round" />
                        <path d="M14 4v5a1 1 0 001 1h5" stroke-linejoin="round" />
                        <path d="M9.5 12.5h1.5v1.5H9.5zM9.5 15.5h1.5V17H9.5zM9.5 9.5h1.5V11H9.5z" />
                    </svg>
                    <h1>Drop a game .zip here</h1>
                    <p>
                        Works with a plain <code>.html</code> + <code>.js</code> zip, or a
                        React/Vite/TypeScript source project (with <code>package.json</code>) —
                        it'll be compiled in your browser. No password-protected zips.
                        Nothing is uploaded anywhere; everything happens locally, and games
                        you load are saved to your library on the left.
                    </p>
                    <button class="btn btn-primary" id="dzChooseBtn">Choose .zip file</button>
                    <div class="dz-hint">Looks for index.html at the root, or lets you pick which file to launch.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="status-bar" id="statusBar" style="display:none;">
        <div id="statusText"></div>
        <div class="right" id="statusRight"></div>
    </div>

    <!-- Bottom dock -->
    <div class="dock" id="dock">
        <button class="dock-btn" id="dockGpuBtn" title="GPU / WebGL settings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M7 9h2v2H7zM11 9h2v2h-2zM15 9h2v2h-2zM7 13h6v2H7z" /></svg>
        </button>
        <button class="dock-btn" id="dockToggleBtn" title="Toggles">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="6" rx="3" /><circle cx="8" cy="9" r="2.2" fill="currentColor" stroke="none" /><rect x="2" y="14" width="20" height="6" rx="3" /><circle cx="17" cy="17" r="2.2" fill="currentColor" stroke="none" /></svg>
        </button>
        <button class="dock-btn" id="dockResBtn" title="Resolution">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="13" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
        </button>
    </div>

    <!-- GPU / WebGL settings panel -->
    <div class="dock-panel" id="gpuPanel">
        <h3>GPU / WebGL Settings</h3>
        <div class="panel-row">
            <label for="gpuPowerPref">Power preference</label>
            <select class="panel-select" id="gpuPowerPref">
                <option value="default">Default</option>
                <option value="high-performance">High performance</option>
                <option value="low-power">Low power</option>
            </select>
        </div>
        <div class="panel-row">
            <label for="gpuAntialias">Antialiasing</label>
            <label class="switch" for="gpuAntialias"><input type="checkbox" id="gpuAntialias" checked><span class="slider"></span></label>
        </div>
        <div class="panel-row">
            <label for="gpuAlpha">Canvas alpha (transparency)</label>
            <label class="switch" for="gpuAlpha"><input type="checkbox" id="gpuAlpha" checked><span class="slider"></span></label>
        </div>
