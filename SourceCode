    </div>

    <!-- Resolution panel -->
    <div class="dock-panel" id="resPanel">
        <h3>Resolution</h3>
        <div class="panel-row">
            <label for="resPreset">Preset</label>
            <select class="panel-select" id="resPreset">
                <option value="fit">Fit window</option>
                <option value="1280x720">1280 × 720</option>
                <option value="1920x1080">1920 × 1080</option>
                <option value="960x540">960 × 540</option>
                <option value="800x600">800 × 600</option>
                <option value="640x480">640 × 480</option>
                <option value="custom">Custom…</option>
            </select>
        </div>
        <div class="custom-res-row" id="customResRow" style="display:none;">
            <input type="number" id="customResW" placeholder="W" min="64" max="7680">
            <span>×</span>
            <input type="number" id="customResH" placeholder="H" min="64" max="4320">
            <button class="btn" id="customResApply" style="padding:5px 10px; font-size:12px;">Apply</button>
        </div>
        <div class="panel-note">
            Sets the game's actual internal resolution (not just a resized box) —
            the game genuinely renders at these dimensions, then gets scaled to
